{
	"name": "xmmath",
	"version": "1.1.3",
	"description": "",
	"main": "./dist/xmmath.umd.js",
	"module": "./dist/xmmath.es.js",
	"exports": {
		".": {
			"import": "./dist/xmmath.es.js",
			"require": "./dist/xmmath.umd.js"
		}
	},
	"homepage": "https://github.com/xushengfeng/xmmath",
	"repository": {
		"url": "https://github.com/xushengfeng/xmmath"
	},
	"type": "module",
	"types": "./src/main.ts",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"review": "vite --host 0.0.0.0 --open /test/review/index.html",
		"sync:symbols": "node test/symbols/gen.mjs",
		"render:typst": "node test/typst/render.mjs",
		"render:xmmath": "node test/xmmath/render.mjs",
		"diff": "node script/diff.mjs",
		"cmp": "node script/cmp.mjs",
		"dev": "vite --host 0.0.0.0",
		"build": "tsc && vite build",
		"preview": "vite preview"
	},
	"keywords": [],
	"author": "",
	"license": "Apache-2.0",
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"jsdom": "^30.1.1",
		"typescript": "^5.4.5",
		"vite": "^4.3.9",
		"vitest": "^1.6.1"
	}
}
